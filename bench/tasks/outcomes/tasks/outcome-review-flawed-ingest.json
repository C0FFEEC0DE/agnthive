        "pattern": "eval\\("
      },
      {
        "id": "initial-traversal-shape",
        "kind": "initial_file_matches",
        "evaluate_in": "mock",
        "where": "seed",
        "path": "ingest.mjs",
        "pattern": "join\\(baseDir, userPath\\)"
      },
      {
        "id": "all-material-findings",
        "kind": "findings_cover",
