  "verification_required": true,
  "docs_required": false,
  "review_required": false,
  "prompt": "The seeded budget module is wrong: it rounds each line before summing, so multi-line totals drift from a single end-rounded total whenever half cents appear across lines. The seeded tests still pass, so tests alone will not lead you there. Add a regression case with an amount of 10.335 on one line plus three 10.3 lines, all at 5 percent tax, asserting the end-rounded total is 43.41. Then fix subtotal so it rounds once after aggregation and the whole suite passes. Work only in the budget module and its test file.",
  "success_criteria": [
    "a regression test pins the four-line half-cent example and asserts 43.41",
    "subtotal rounds once after aggregation; per-line rounding is gone",
    "the seeded tests still pass together with the new regression case"
  ],
  "must_not": [
    "do not run release or deploy automation (the profile keeps it disabled)",
    "do not edit files outside the declared task scope",
    "do not weaken or delete existing tests to make the task pass"
  ],
